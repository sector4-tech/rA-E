+// When on, "@ab start" is refused; stopping with "@ab stop" is always allowed.
+autobattle_item_only: on
+
+// Effect shown to everybody nearby while a character is using Auto Battle (EF_ id, 0 = none).
+// Default 76 = EF_MAGNIFICAT. Make sure the effect exists in your client.
+autobattle_effect: 76
+
+// How often (milliseconds) the effect above is repeated. 0 to disable. (0~60000)
+autobattle_effect_interval: 3000
