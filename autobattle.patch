diff --git a/doc/autobattle.md b/doc/autobattle.md
new file mode 100644
index 0000000..37a34f3
--- /dev/null
+++ b/doc/autobattle.md
@@ -0,0 +1,47 @@
+# Auto Battle (server side)
+
+Command: `@autobattle` (alias `@ab`). Permission: `autobattle` (conf/groups.yml).
+Config: `conf/battle/feature.conf` (`autobattle_*`).
+
+## Starting / stopping (item based)
+* Use the **Auto Battle Pass** (`Auto_Battle_Pass`, id 32500, not consumed) to start or stop Auto Battle.
+  The item runs the script command `autobattle 2;` (0 = stop, 1 = start, 2 = toggle).
+* While active the character has the status `SC_AUTOBATTLE` (icon `EFST_AUTOBERSERK`, shown to nearby
+  players) and a periodic effect is played around the character so other players can tell
+  Auto Battle from manual play. Settings: `autobattle_item_only`, `autobattle_effect`,
+  `autobattle_effect_interval` in `conf/battle/feature.conf`.
+* With `autobattle_item_only: on` (default) `@ab start` is refused; `@ab stop` still works.
+* The client needs an `iteminfo` entry for id 32500 to show a proper name/icon. The server item
+  and status are in `db/re` and `db/pre-re` (`item_db_usable.yml`, `status.yml`).
+
+## Setup dialog (no client changes needed)
+* `@ab menu` opens the dialog anywhere, or talk to **Auto Battle Manager** (prontera,155,181).
+* The dialog is `npc/custom/autobattle.txt` (enabled in `npc/scripts_custom.conf`).
+* It only uses `@ab -q ...` commands (`-q` = quiet) and reads the character variables `ab_*`.
+
+## Commands
+```
+start | stop | toggle | status | mobs | menu | sync | skills <attack|buff|support>
+all <on|off> | attack <on|off> | fightback <on|off>
+mob +<id|name> / -<id|name> / reset
+skill <slot 1-16> <skill id|name> [lv] | skill clear <slot|all>
+hp|sp <item id|name|off> [%]
+buff <slot 1-8> <skill> [lv] | buff clear <slot|all>
+support <slot 1-4> <skill> [lv] | support clear <slot|all> | support hp <%>
+loot <on|off> | loot range <1-14> | loot +<item> / -<item> / reset
+restock <on|off> | restock +<item> <amount> / -<item> / reset | restock min <n>
+safety hp <%> | safety item <item|off> | safety player <on|off>
+safety weight <on|off> [%] | safety noitem <on|off> | safety idle <sec>
+```
+Item/monster/skill names: use the id or the Aegis name (underscores instead of spaces).
+
+## Character variables (read by the dialog, written by the server)
+`ab_flags` (1 all, 2 normal attack, 4 fight back, 8 loot, 16 restock, 32 stop on player,
+64 stop on weight, 128 stop on no item), `ab_hpitem`, `ab_spitem`, `ab_fleeitem`, `ab_pct1`, `ab_pct2`,
+`ab_misc`, `ab_atk[16]`, `ab_buff[8]`, `ab_sup[4]` (skill id << 16 | level), `ab_mob[20]`, `ab_loot[30]`,
+`ab_rsid[8]` / `ab_rsamt[8]`. Temporary: `@ab_running`, `@ab_mobn`, `@ab_mobid[]`, `@ab_mobcnt[]`,
+`@ab_skn`, `@ab_skid[]`, `@ab_sklv[]`, `@ab_skname$[]`, `@ab_atkn$[]`, `@ab_buffn$[]`, `@ab_supn$[]`.
+
+## Client UI
+The window shown in newer clients is not part of Ragexe 2026-01-06/07. A DLL / client patch can
+reuse the same commands or variables; see the packet notes in the discussion.
diff --git a/npc/custom/autobattle.txt b/npc/custom/autobattle.txt
new file mode 100644
index 0000000..0b5f719
--- /dev/null
+++ b/npc/custom/autobattle.txt
@@ -0,0 +1,521 @@
+//===== rAthena Script =======================================
+//= Auto Battle - setup dialog
+//===== Description: =========================================
+//= NPC based front-end for the server side Auto Battle system
+//= (src/map/autobattle.cpp, command: @autobattle / @ab).
+//= Open it with the town NPC below or with "@ab menu" anywhere.
+//= The tabs mirror the client style window:
+//=   Hunt / Recovery / Buffs / Support / Loot / Restock / Safety
+//===== Requires: ============================================
+//= - Auto Battle patch applied (autobattle.cpp)
+//= - Players need the "autobattle" permission (conf/groups.yml)
+//===== Notes: ===============================================
+//= The dialog only talks to the server through "@ab -q ..." commands
+//= and reads the settings from the character variables ab_*.
+//= Change the coordinates of the town NPC to suit your map.
+//============================================================
+
+-	script	AutoBattleUI	-1,{
+	end;
+
+OnOpen:
+	callfunc "F_ABUI";
+	end;
+}
+
+prontera,155,181,4	script	Auto Battle Manager	4_F_KAFRA1,{
+	callfunc "F_ABUI";
+	end;
+}
+
+function	script	F_ABUI	{
+	atcommand "@ab -q sync";
+
+	while (1) {
+		clear;
+		mes "[Auto Battle]";
+		mes "Status: " + (@ab_running ? "^009900RUNNING^000000" : "^CC0000Stopped^000000");
+		.@item_only = getbattleflag("autobattle_item_only");
+		if (.@item_only)
+			mes "Use the ^0000FFAuto Battle Pass^000000 item to start / stop.";
+		mes "Type ^0000FF@ab help^000000 for chat commands.";
+		.@first$ = @ab_running ? "Stop" : (.@item_only ? "Get the Auto Battle Pass" : "Start");
+		.@s = select(.@first$ + ":Hunt:Recovery:Buffs:Support:Loot:Restock:Safety:Show summary in chat:Close");
+		switch (.@s) {
+		case 1:
+			if (@ab_running)
+				atcommand "@ab -q stop";
+			else if (.@item_only) {
+				if (countitem(32500)) {
+					mes "You already have an Auto Battle Pass.";
+					next;
+				} else {
+					getitem 32500, 1;
+					mes "Here is your Auto Battle Pass.";
+					next;
+				}
+			} else
+				atcommand "@ab -q start";
+			break;
+		case 2: callsub L_Hunt; break;
+		case 3: callsub L_Recovery; break;
+		case 4: callsub L_SkillSlots, "Buffs", "buff", "ab_buff", 8, "buff"; break;
+		case 5: callsub L_Support; break;
+		case 6: callsub L_Loot; break;
+		case 7: callsub L_Restock; break;
+		case 8: callsub L_Safety; break;
+		case 9: atcommand "@ab status"; break;
+		case 10: close;
+		}
+	}
+	close;
+
+// ------------------------------------------------------------ helpers
+L_OnOff:
+	return (getarg(0) ? "^009900ON^000000" : "^CC0000OFF^000000");
+
+L_ItemName:
+	if (getarg(0) <= 0)
+		return "-";
+	return getitemname(getarg(0));
+
+// Asks for an item ID / Aegis name, returns "" when nothing was typed
+L_AskItem:
+	clear;
+	mes "[" + getarg(0) + "]";
+	mes "Type the item ID or Aegis name.";
+	mes "Example: ^0000FF501^000000 or ^0000FFRed_Potion^000000";
+	input .@s$;
+	return replacestr(.@s$, " ", "_");
+
+// Pick a healing item from the inventory (or type one). Returns "" on cancel.
+L_PickItem:
+	getinventorylist;
+	.@n = 0;
+	.@m$ = "";
+	for (.@i = 0; .@i < @inventorylist_count && .@n < 15; .@i++) {
+		if (getiteminfo(@inventorylist_id[.@i], ITEMINFO_TYPE) == IT_HEALING) {
+			.@ids[.@n] = @inventorylist_id[.@i];
+			.@m$ += getitemname(@inventorylist_id[.@i]) + " (" + @inventorylist_amount[.@i] + "):";
+			.@n++;
+		}
+	}
+	clear;
+	mes "[Choose an item]";
+	mes "Healing items in your inventory:";
+	.@c = select(.@m$ + "Type an item ID / name:Cancel");
+	if (.@c == .@n + 2)
+		return "";
+	if (.@c == .@n + 1)
+		return callsub(L_AskItem, "Choose an item");
+	return "" + .@ids[.@c - 1];
+
+// Pick a learned skill. getarg(0) = attack | buff | support. Returns (id << 16) | level, or 0.
+L_PickSkill:
+	atcommand "@ab -q skills " + getarg(0);
+	if (!@ab_skn) {
+		clear;
+		mes "[Choose a skill]";
+		mes "You have no suitable skills for this tab.";
+		next;
+		return 0;
+	}
+	.@page = 0;
+	.@per = 9;
+	while (1) {
+		.@start = .@page * .@per;
+		.@cnt = min(.@per, @ab_skn - .@start);
+		.@m$ = "";
+		for (.@i = .@start; .@i < .@start + .@cnt; .@i++)
+			.@m$ += @ab_skname$[.@i] + " (Lv " + @ab_sklv[.@i] + "):";
+		.@more = (.@start + .@per < @ab_skn);
+		if (.@more)
+			.@m$ += "Next page:";
+		if (.@page)
+			.@m$ += "Previous page:";
+		clear;
+		mes "[Choose a skill]";
+		mes "Page " + (.@page + 1) + " / " + ((@ab_skn + .@per - 1) / .@per);
+		.@c = select(.@m$ + "Cancel") - 1;
+		if (.@c < .@cnt) {
+			.@id = @ab_skid[.@start + .@c];
+			.@max = @ab_sklv[.@start + .@c];
+			clear;
+			mes "[Choose a skill]";
+			mes @ab_skname$[.@start + .@c];
+			mes "Skill level to use (1-" + .@max + "):";
+			input .@lv, 1, .@max;
+			return (.@id << 16) | .@lv;
+		}
+		.@c -= .@cnt;
+		if (.@more) {
+			if (.@c == 0) { .@page++; continue; }
+			.@c--;
+		}
+		if (.@page) {
+			if (.@c == 0) { .@page--; continue; }
+		}
+		return 0;
+	}
+
+// Skill slots editor: title$, command$, array$, slots, kind$
+L_SkillSlots:
+	.@title$ = getarg(0);
+	.@cmd$ = getarg(1);
+	.@arr$ = getarg(2);
+	.@n = getarg(3);
+	.@kind$ = getarg(4);
+	while (1) {
+		.@m$ = "";
+		for (.@i = 0; .@i < .@n; .@i++) {
+			.@v = getd(.@arr$ + "[" + .@i + "]");
+			if (.@v)
+				.@m$ += "[" + (.@i + 1) + "] " + getd("@" + .@arr$ + "n$[" + .@i + "]") + " Lv " + (.@v & 0xFFFF) + ":";
+			else
+				.@m$ += "[" + (.@i + 1) + "] (empty):";
+		}
+		clear;
+		mes "[" + .@title$ + "]";
+		mes "Select a slot to add or change a skill.";
+		.@c = select(.@m$ + "Clear all slots:Back");
+		if (.@c == .@n + 2)
+			return;
+		if (.@c == .@n + 1) {
+			atcommand "@ab -q " + .@cmd$ + " clear all";
+			continue;
+		}
+		.@slot = .@c - 1;
+		if (getd(.@arr$ + "[" + .@slot + "]")) {
+			clear;
+			mes "[" + .@title$ + "]";
+			mes "Slot " + (.@slot + 1) + ":";
+			.@a = select("Change skill:Clear this slot:Cancel");
+			if (.@a == 2) {
+				atcommand "@ab -q " + .@cmd$ + " clear " + (.@slot + 1);
+				continue;
+			}
+			if (.@a == 3)
+				continue;
+		}
+		.@p = callsub(L_PickSkill, .@kind$);
+		if (.@p)
+			atcommand "@ab -q " + .@cmd$ + " " + (.@slot + 1) + " " + (.@p >> 16) + " " + (.@p & 0xFFFF);
+	}
+
+// ------------------------------------------------------------ Hunt
+L_Hunt:
+	while (1) {
+		clear;
+		mes "[Hunt]";
+		mes "Attack every monster: " + callsub(L_OnOff, ab_flags & 1);
+		mes "Normal attack: " + callsub(L_OnOff, ab_flags & 2);
+		mes "Fight back when attacked: " + callsub(L_OnOff, ab_flags & 4);
+		mes "Target monsters:";
+		.@n = 0;
+		for (.@i = 0; .@i < 20; .@i++) {
+			if (ab_mob[.@i]) {
+				mes "  - " + getmonsterinfo(ab_mob[.@i], MOB_NAME) + " (" + ab_mob[.@i] + ")";
+				.@n++;
+			}
+		}
+		if (!.@n)
+			mes "  (none)";
+		.@s = select("Toggle: attack every monster:Toggle: normal attack:Toggle: fight back when attacked:Add target monster:Remove target monster:Clear target monsters:Attack skills:Back");
+		switch (.@s) {
+		case 1: atcommand "@ab -q all " + ((ab_flags & 1) ? "off" : "on"); break;
+		case 2: atcommand "@ab -q attack " + ((ab_flags & 2) ? "off" : "on"); break;
+		case 3: atcommand "@ab -q fightback " + ((ab_flags & 4) ? "off" : "on"); break;
+		case 4: callsub L_AddMob; break;
+		case 5: callsub L_DelMob; break;
+		case 6: atcommand "@ab -q mob reset"; break;
+		case 7: callsub L_SkillSlots, "Attack skills", "skill", "ab_atk", 16, "attack"; break;
+		case 8: return;
+		}
+	}
+
+L_AddMob:
+	atcommand "@ab -q mobs";
+	.@m$ = "";
+	for (.@i = 0; .@i < @ab_mobn; .@i++)
+		.@m$ += getmonsterinfo(@ab_mobid[.@i], MOB_NAME) + " (" + @ab_mobcnt[.@i] + " on this map):";
+	clear;
+	mes "[Add target monster]";
+	mes "Monsters on your current map:";
+	.@c = select(.@m$ + "Type a monster ID / name:Cancel");
+	if (.@c == @ab_mobn + 2)
+		return;
+	if (.@c == @ab_mobn + 1) {
+		clear;
+		mes "[Add target monster]";
+		mes "Type the monster ID or Aegis name.";
+		mes "Example: ^0000FF1002^000000 or ^0000FFPORING^000000";
+		input .@s$;
+		.@s$ = replacestr(.@s$, " ", "_");
+		if (.@s$ != "")
+			atcommand "@ab -q mob +" + .@s$;
+		return;
+	}
+	atcommand "@ab -q mob +" + @ab_mobid[.@c - 1];
+	return;
+
+L_DelMob:
+	.@n = 0;
+	.@m$ = "";
+	for (.@i = 0; .@i < 20; .@i++) {
+		if (ab_mob[.@i]) {
+			.@ids[.@n] = ab_mob[.@i];
+			.@m$ += getmonsterinfo(ab_mob[.@i], MOB_NAME) + ":";
+			.@n++;
+		}
+	}
+	clear;
+	mes "[Remove target monster]";
+	if (!.@n) {
+		mes "The list is empty.";
+		next;
+		return;
+	}
+	.@c = select(.@m$ + "Cancel");
+	if (.@c > .@n)
+		return;
+	atcommand "@ab -q mob -" + .@ids[.@c - 1];
+	return;
+
+// ------------------------------------------------------------ Recovery
+L_Recovery:
+	while (1) {
+		clear;
+		mes "[Recovery]";
+		mes "HP item: " + callsub(L_ItemName, ab_hpitem) + "  (below " + (ab_pct1 & 0xFF) + "% HP)";
+		mes "SP item: " + callsub(L_ItemName, ab_spitem) + "  (below " + ((ab_pct1 >> 8) & 0xFF) + "% SP)";
+		.@s = select("Set HP item:Set HP %:Clear HP item:Set SP item:Set SP %:Clear SP item:Back");
+		switch (.@s) {
+		case 1:
+			.@i$ = callsub(L_PickItem);
+			if (.@i$ != "")
+				atcommand "@ab -q hp " + .@i$;
+			break;
+		case 4:
+			.@i$ = callsub(L_PickItem);
+			if (.@i$ != "")
+				atcommand "@ab -q sp " + .@i$;
+			break;
+		case 2:
+		case 5:
+			.@t$ = (.@s == 2) ? "hp" : "sp";
+			.@item = (.@s == 2) ? ab_hpitem : ab_spitem;
+			clear;
+			mes "[Recovery]";
+			if (!.@item) {
+				mes "Choose the " + .@t$ + " item first.";
+				next;
+				break;
+			}
+			mes "Use the item when " + .@t$ + " is below (1-99%):";
+			input .@v, 1, 99;
+			atcommand "@ab -q " + .@t$ + " " + .@item + " " + .@v;
+			break;
+		case 3: atcommand "@ab -q hp off"; break;
+		case 6: atcommand "@ab -q sp off"; break;
+		case 7: return;
+		}
+	}
+
+// ------------------------------------------------------------ Support
+L_Support:
+	while (1) {
+		clear;
+		mes "[Support]";
+		mes "Heals you and party members when their HP is below ^0000FF" + ((ab_pct1 >> 16) & 0xFF) + "%^000000.";
+		.@s = select("Support skill slots:Set HP threshold:Back");
+		switch (.@s) {
+		case 1: callsub L_SkillSlots, "Support skills", "support", "ab_sup", 4, "support"; break;
+		case 2:
+			clear;
+			mes "[Support]";
+			mes "Heal when HP is below (1-100%):";
+			input .@v, 1, 100;
+			atcommand "@ab -q support hp " + .@v;
+			break;
+		case 3: return;
+		}
+	}
+
+// ------------------------------------------------------------ Loot
+L_Loot:
+	while (1) {
+		clear;
+		mes "[Loot]";
+		mes "Pick up items: " + callsub(L_OnOff, ab_flags & 8);
+		mes "Range: " + ((ab_pct2 >> 8) & 0xFF) + " cells";
+		mes "Filter:";
+		.@n = 0;
+		for (.@i = 0; .@i < 30; .@i++) {
+			if (ab_loot[.@i]) {
+				mes "  - " + getitemname(ab_loot[.@i]);
+				.@n++;
+			}
+		}
+		if (!.@n)
+			mes "  (everything)";
+		.@s = select("Toggle looting:Set range:Add item to filter:Remove item from filter:Pick up everything (clear filter):Back");
+		switch (.@s) {
+		case 1: atcommand "@ab -q loot " + ((ab_flags & 8) ? "off" : "on"); break;
+		case 2:
+			clear;
+			mes "[Loot]";
+			mes "Pick-up range (1-14 cells):";
+			input .@v, 1, 14;
+			atcommand "@ab -q loot range " + .@v;
+			break;
+		case 3:
+			.@i$ = callsub(L_AskItem, "Loot filter");
+			if (.@i$ != "")
+				atcommand "@ab -q loot +" + .@i$;
+			break;
+		case 4:
+			.@m$ = "";
+			.@k = 0;
+			for (.@i = 0; .@i < 30; .@i++) {
+				if (ab_loot[.@i]) {
+					.@ids[.@k] = ab_loot[.@i];
+					.@m$ += getitemname(ab_loot[.@i]) + ":";
+					.@k++;
+				}
+			}
+			clear;
+			mes "[Loot]";
+			if (!.@k) {
+				mes "The filter is empty.";
+				next;
+				break;
+			}
+			.@c = select(.@m$ + "Cancel");
+			if (.@c <= .@k)
+				atcommand "@ab -q loot -" + .@ids[.@c - 1];
+			break;
+		case 5: atcommand "@ab -q loot reset"; break;
+		case 6: return;
+		}
+	}
+
+// ------------------------------------------------------------ Restock
+L_Restock:
+	while (1) {
+		clear;
+		mes "[Restock]";
+		mes "Enabled: " + callsub(L_OnOff, ab_flags & 16);
+		mes "When an item drops below ^0000FF" + (ab_misc & 0xFFFF) + "^000000 you are warped";
+		mes "to your save point, the items are bought";
+		mes "with zeny (NPC price) and you return.";
+		.@n = 0;
+		for (.@i = 0; .@i < 8; .@i++) {
+			if (ab_rsid[.@i]) {
+				mes "  - " + getitemname(ab_rsid[.@i]) + " -> " + ab_rsamt[.@i];
+				.@n++;
+			}
+		}
+		if (!.@n)
+			mes "  (no items)";
+		.@s = select("Toggle restock:Add / update item:Remove item:Set minimum amount:Clear list:Back");
+		switch (.@s) {
+		case 1: atcommand "@ab -q restock " + ((ab_flags & 16) ? "off" : "on"); break;
+		case 2:
+			.@i$ = callsub(L_AskItem, "Restock item");
+			if (.@i$ == "")
+				break;
+			clear;
+			mes "[Restock]";
+			mes "Amount to hold after restocking (1-30000):";
+			input .@v, 1, 30000;
+			atcommand "@ab -q restock +" + .@i$ + " " + .@v;
+			break;
+		case 3:
+			.@m$ = "";
+			.@k = 0;
+			for (.@i = 0; .@i < 8; .@i++) {
+				if (ab_rsid[.@i]) {
+					.@ids[.@k] = ab_rsid[.@i];
+					.@m$ += getitemname(ab_rsid[.@i]) + ":";
+					.@k++;
+				}
+			}
+			clear;
+			mes "[Restock]";
+			if (!.@k) {
+				mes "The list is empty.";
+				next;
+				break;
+			}
+			.@c = select(.@m$ + "Cancel");
+			if (.@c <= .@k)
+				atcommand "@ab -q restock -" + .@ids[.@c - 1];
+			break;
+		case 4:
+			clear;
+			mes "[Restock]";
+			mes "Restock when an item drops below (1-30000):";
+			input .@v, 1, 30000;
+			atcommand "@ab -q restock min " + .@v;
+			break;
+		case 5: atcommand "@ab -q restock reset"; break;
+		case 6: return;
+		}
+	}
+
+// ------------------------------------------------------------ Safety
+L_Safety:
+	while (1) {
+		clear;
+		mes "[Safety]";
+		.@flee = (ab_pct1 >> 24) & 0xFF;
+		mes "Escape when HP below: " + (.@flee ? .@flee + "%" : "^CC0000OFF^000000");
+		mes "Escape item: " + callsub(L_ItemName, ab_fleeitem);
+		mes "Stop if another player is near: " + callsub(L_OnOff, ab_flags & 32);
+		mes "Stop when overweight (" + (ab_pct2 & 0xFF) + "%): " + callsub(L_OnOff, ab_flags & 64);
+		mes "Stop when potions run out: " + callsub(L_OnOff, ab_flags & 128);
+		mes "Use escape item after idle: " + (((ab_misc >> 16) & 0x3FFF) ? ((ab_misc >> 16) & 0x3FFF) + "s" : "^CC0000OFF^000000");
+		.@s = select("Set escape HP %:Set escape item:Toggle: stop if a player is near:Toggle: stop when overweight:Set overweight %:Toggle: stop when potions run out:Set idle seconds:Back");
+		switch (.@s) {
+		case 1:
+			clear;
+			mes "[Safety]";
+			mes "Escape when HP is below (0 = off, max 90%):";
+			input .@v, 0, 90;
+			atcommand "@ab -q safety hp " + .@v;
+			break;
+		case 2:
+			clear;
+			mes "[Safety]";
+			.@c = select("Fly Wing:Butterfly Wing:Other item:No escape item:Cancel");
+			if (.@c == 1) atcommand "@ab -q safety item 601";
+			else if (.@c == 2) atcommand "@ab -q safety item 602";
+			else if (.@c == 3) {
+				.@i$ = callsub(L_AskItem, "Escape item");
+				if (.@i$ != "")
+					atcommand "@ab -q safety item " + .@i$;
+			}
+			else if (.@c == 4) atcommand "@ab -q safety item off";
+			break;
+		case 3: atcommand "@ab -q safety player " + ((ab_flags & 32) ? "off" : "on"); break;
+		case 4: atcommand "@ab -q safety weight " + ((ab_flags & 64) ? "off" : "on"); break;
+		case 5:
+			clear;
+			mes "[Safety]";
+			mes "Stop when weight reaches (10-100%):";
+			input .@v, 10, 100;
+			atcommand "@ab -q safety weight " + ((ab_flags & 64) ? "on" : "off") + " " + .@v;
+			break;
+		case 6: atcommand "@ab -q safety noitem " + ((ab_flags & 128) ? "off" : "on"); break;
+		case 7:
+			clear;
+			mes "[Safety]";
+			mes "Use the escape item when no monster was found";
+			mes "for this many seconds (0 = off, max 3600):";
+			input .@v, 0, 3600;
+			atcommand "@ab -q safety idle " + .@v;
+			break;
+		case 8: return;
+		}
+	}
+}
